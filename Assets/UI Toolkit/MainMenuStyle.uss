.visual-element {
    background-color: rgb(10, 15, 30); /* тёмный фон */
    border-radius: 20px;
    padding: 20px;

    width: 400px;
    height: 300px;

    margin: auto;
    align-items: center;
    justify-content: center;

    border-width: 2px;
    border-color: rgb(0, 200, 255); /* неоновая рамка */

    box-shadow: 0 0 15px rgba(0, 200, 255, 0.5); /* свечение */
}

.label {
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;

    margin-bottom: 20px;

    unity-text-align: middle-center;

    text-shadow: 0 0 8px rgba(0, 200, 255, 0.8);
}

.button {
    background-color: rgb(15, 25, 50); /* тёмно-синий */
    color: rgb(0, 200, 255); /* неоновый текст */

    border-radius: 12px;
    padding: 12px 24px;

    font-size: 16px;
    -unity-font-style: bold;

    border-width: 2px;
    border-color: rgb(0, 200, 255);

    margin-top: 10px;
    width: 200px;

    transition-duration: 0.1s;

    box-shadow: 0 0 10px rgba(0, 200, 255, 0.4);
}

.button:hover {
    background-color: rgb(25, 40, 80);
    border-color: rgb(120, 0, 255); /* фиолетовый акцент */
    box-shadow: 0 0 15px rgba(120, 0, 255, 0.7);
}

.button:active {
    background-color: rgb(5, 10, 20);
    box-shadow: 0 0 5px rgba(0, 200, 255, 0.3);
}