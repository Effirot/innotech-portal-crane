<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="back-image" style="flex-grow: 1; width: 350px; height: 230px; position: relative; top: auto; left: auto; bottom: auto; right: auto;">
        <ui:Label text="СИМУЛЯТОР КРАНА" name="game-title" style="background-color: rgba(0, 0, 0, 0); width: auto; height: auto; flex-direction: column; left: auto; right: auto; margin-left: 100px; padding-left: 2px;" />
        <ui:VisualElement name="menu-panel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.29); top: auto; left: auto; right: auto; bottom: auto; position: relative; width: 50%; flex-direction: column; align-items: stretch; justify-content: space-evenly; align-self: stretch; height: 50%; align-content: flex-start; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; margin-left: 90px; margin-bottom: 66px; margin-top: 60px;">
            <ui:Button text="Начать" name="btn-start" class="start-button" style="margin-bottom: 2px; background-color: rgb(255, 179, 0); -unity-font-style: bold; font-size: 16px; -unity-font-definition: resource(&apos;FlatSkin/Font/Roboto-Regular&apos;);" />
            <ui:Button text="Выход" name="btn-quit" style="background-color: rgb(255, 179, 0); font-size: 16px; -unity-font-style: bold; -unity-font-definition: resource(&apos;FlatSkin/Font/Roboto-Regular&apos;);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
