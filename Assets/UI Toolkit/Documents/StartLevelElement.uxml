<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/StyleStartLevelElement.uss?fileID=7433441132597879392&amp;guid=93583a5aea681da47b3d68a329ae6727&amp;type=3#StyleStartLevelElement"/>
    <ui:Button name="ButtonLevel" class="button-level-element" style="height: 878px; width: 515px;">
        <ui:VisualElement name="icon" class="icon" style="flex-grow: 0; height: 40%;">
            <Bindings>
                <ui:DataBinding property="style.backgroundImage" data-source-path="_image" data-source-type="Level, Assembly-CSharp" binding-mode="ToTarget"/>
            </Bindings>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1;">
            <ui:Label text="Label" name="LabelName" class="label-name" style="-unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Regular&quot;);">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="_levelName" data-source-type="Level, Assembly-CSharp" binding-mode="TwoWay"/>
                </Bindings>
            </ui:Label>
            <ui:Label text="Label" name="LabelDesc" class="label-desc" style="-unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Regular&quot;);">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="_description" data-source-type="Level, Assembly-CSharp" binding-mode="TwoWay"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
