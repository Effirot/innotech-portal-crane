.button-level-element {
    flex-grow: 0;
    background-color: rgb(10, 15, 30);
    border-radius: 20px;
    border-color: rgb(0, 200, 255);
    border-width: 2px;

    width: 600px;
    height: 100px;
    margin: 5px;
    overflow: hidden;
    cursor: pointer;

    position: absolute;
    top: 780px;
    left: auto;
    right: auto;
    bottom: 0;

    justify-content: center;
    align-self: center;
    align-content: flex-end;

    padding: 20px;
    flex-shrink: 0;
    flex-direction: column;

    box-shadow: 0 0 15px rgba(0, 200, 255, 0.4);
}

.button-level-element:hover {
    background-color: rgb(15, 25, 50);
    border-color: rgb(120, 0, 255);
    box-shadow: 0 0 20px rgba(120, 0, 255, 0.7);
}

.button-level-element:active {
    background-color: rgb(5, 10, 20);
    box-shadow: 0 0 5px rgba(0, 200, 255, 0.3);
}

.level-name {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
    font-size: 24px;

    text-shadow: 0 0 8px rgba(0, 200, 255, 0.8);
}

.level-description {
    color: rgb(150, 200, 255);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    white-space: normal;
    -unity-text-align: middle-center;

    text-shadow: 0 0 6px rgba(0, 200, 255, 0.5);
}