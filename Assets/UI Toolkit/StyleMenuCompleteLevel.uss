.visual-element {
    background-color: rgb(10, 15, 30);
    border-radius: 20px;
    padding: 20px;

    width: 400px;
    height: 250px;

    margin: auto;
    align-items: center;
    justify-content: center;

    border-width: 2px;
    border-color: rgb(0, 200, 255);

    box-shadow: 0 0 15px rgba(0, 200, 255, 0.5);
}

.label {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 20px;

    text-shadow: 0 0 8px rgba(0, 200, 255, 0.8);
}

.button {
    background-color: rgb(15, 25, 50);
    color: rgb(0, 200, 255);

    border-radius: 12px;
    padding: 12px 24px;
    font-size: 16px;
    -unity-font-style: bold;

    border-width: 2px;
    border-color: rgb(0, 200, 255);

    transition-duration: 0.1s;

    box-shadow: 0 0 10px rgba(0, 200, 255, 0.4);
}

.button:hover {
    background-color: rgb(25, 40, 80);
    border-color: rgb(120, 0, 255);
    box-shadow: 0 0 15px rgba(120, 0, 255, 0.7);
}

.button:active {
    background-color: rgb(5, 10, 20);
    box-shadow: 0 0 5px rgba(0, 200, 255, 0.3);
}