.icon {
    height: 40%;
}

.button-level-element {
    flex-grow: 0;
    background-color: rgb(10, 15, 30); /* тёмный sci-fi фон */
    border-radius: 20px;
    border-width: 2px;
    border-color: rgb(0, 200, 255); /* неоновый голубой */
    width: 500px;
    height: 500px;
    margin: 5px;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    font-size: 10px;

    box-shadow: 0 0 10px rgba(0, 200, 255, 0.5); /* свечение */
}

.button-level-element:hover {
    background-color: rgb(15, 25, 50);
    border-color: rgb(120, 0, 255); /* фиолетовый при hover */
    box-shadow: 0 0 20px rgba(120, 0, 255, 0.7);
}

.button-level-element:active {
    background-color: rgb(5, 10, 20);
    box-shadow: 0 0 5px rgba(0, 200, 255, 0.3);
}

.label-name {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    align-self: center;
    -unity-text-align: middle-center;
    white-space: normal;

    text-shadow: 0 0 8px rgba(0, 200, 255, 0.8);
}

.label-desc {
    color: rgb(150, 200, 255);
    font-size: 18px;
    align-self: center;
    -unity-text-align: middle-center;
    white-space: normal;

    text-shadow: 0 0 6px rgba(0, 200, 255, 0.5);
}